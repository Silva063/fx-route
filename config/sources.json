      },
      "params": {
        "url": "https://procreditbank.md/ro/schimb_valutar",
        "quote": "MDL",
        "tables": [
          {
            "table": "cash",
            "locate": {
              "selector": "form#procredit-exchange-rates-cash-form table"
            },
            "container": "section",
            "expect": "numerar",
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            },
            "date": {
              "selector": "section.procredit-exchange-rates-cash-form",
              "regex": "la data de (\\d{2}\\.\\d{2}\\.\\d{4})"
            }
          },
          {
            "table": "card",
            "locate": {
              "selector": "form#procredit-exchange-rates-card-form table"
            },
            "container": "section",
            "expect": "card",
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            },
            "date": {
              "selector": "section.procredit-exchange-rates-card-form",
              "regex": "la data de (\\d{2}\\.\\d{2}\\.\\d{4})"
            }
          }
        ]
      }
    },
