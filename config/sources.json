    {
      "id": "bankexim-pmr",
      "name": "Эксимбанк (ПМР)",
      "jurisdiction": "PMR",
      "kind": "bank",
      "website": "https://bankexim.com/",
      "ratesUrl": "https://bankexim.com/",
      "collect": "auto",
      "adapter": "html-tables",
      "tables": {
        "branches": {
          "label": "В отделениях Банка",
          "channel": "cash",
          "channelConfidence": "assumed",
          "use": "offer"
        },
        "internet-bank": {
          "label": "В Интернет-Банке",
          "channel": "online",
          "use": "offer"
        }
      },
      "note": "Сайт за FOXCLOUD: проверка браузера срабатывает выборочно. При challenge — статус protected, только вручную. Не путать с Eximbank Молдовы.",
      "params": {
        "url": "https://bankexim.com/",
        "quote": "RUP",
        "tables": [
          {
            "table": "branches",
            "locate": {
              "heading": "^В отделениях Банка$"
            },
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            }
          },
          {
            "table": "internet-bank",
            "locate": {
              "heading": "^В Интернет-Банке$"
            },
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            }
          }
        ]
      }
    },
    {
      "id": "maib",
      "name": "maib (Moldova-Agroindbank)",
      "jurisdiction": "MD",
      "kind": "bank",
      "website": "https://www.maib.md/",
      "ratesUrl": "https://www.maib.md/ro/curs-valutar",
      "collect": "auto",
      "adapter": "html-tables",
      "tables": {
        "cash-branches": {
          "label": "Schimb valutar în numerar din sucursale",
          "channel": "cash",
          "use": "offer"
        },
        "card": {
          "label": "Operațiuni cu card",
          "channel": "card",
          "use": "offer"
        }
      },
      "excludedTables": {
        "customs": "Наличные в таможенных агентствах — исключено по решению владельца",
        "atm": "Обмен в банкоматах (4 категории) — не включать (решение владельца)"
      },
      "params": {
        "url": "https://www.maib.md/ro/curs-valutar",
        "quote": "MDL",
        "tables": [
          {
            "table": "cash-branches",
            "locate": {
              "selector": "#one-one-new table"
            },
            "expect": "numerar din sucursale",
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            }
          },
          {
            "table": "card",
            "locate": {
              "selector": "#two-new table"
            },
            "expect": "cardul",
            "columns": {
              "code": 0,
              "buy": 1,
              "sell": 2
            },
            "date": {
              "selector": "#two-new",
              "regex": "la data (\\d{2}\\.\\d{2}\\.\\d{4})"
            }
          }
        ]
      }
    },
