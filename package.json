{
  "name": "fx-route",
  "version": "0.1.0",
  "private": true,
  "description": "Поиск оптимального маршрута обмена валют ПМР ↔ Молдова",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "collect": "tsx src/collector/cli.ts collect",
    "merge": "tsx src/collector/cli.ts merge",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "capture": "tsx src/collector/cli.ts capture",
    "route": "tsx src/collector/cli.ts route",
    "web:data": "tsx scripts/prepare-web-data.ts",
    "dev": "npm run web:data && vite",
    "build": "npm run web:data && vite build",
    "preview": "vite preview",
    "publish-data": "tsx scripts/publish-data.ts",
    "update": "npm run collect && npm run publish-data"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
